{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "meta": {
    "title": "Remote Data Blocks Demo",
    "description": "Installs plugins to demo Remote Data Blocks.",
    "author": "WordPress VIP",
    "categories": [
      "Content"
    ]
  },
  "features": {
    "networking": true
  },
  "landingPage": "/wp-admin/post-new.php",
  "login": true,
  "preferredVersions": {
    "php": "8.2",
    "wp": "latest"
  },
  "steps": [
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "wordpress.org/plugins",
        "slug": "jetpack"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "setSiteOptions",
      "options": {
        "jetpack_active_modules": [
          "blocks",
          "subscriptions"
        ]
      }
    },
    {
      "step": "defineWpConfigConsts",
      "consts": {
        "USE_PLAYGROUND_CORS_PROXY": true,
        "JETPACK_DEBUG": "true",
        "JETPACK_DEV_DEBUG": "true",
        "DNS_NS": 0
      }
    },
    {
      "step": "installPlugin",
      "options": {
        "activate": true,
        "targetFolderName": "remote-data-blocks"
      },
      "pluginData": {
        "caption": "Installing Remote Data Blocks",
        "resource": "url",
        "url": "https://github-proxy.com/proxy/?repo=Automattic/remote-data-blocks&release=latest&asset=remote-data-blocks.zip"
      }
    },
    {
      "step": "mkdir",
      "path": "/wordpress/wp-content/plugins/airtable-demo"
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/plugins/airtable-demo/airtable-demo.php",
      "data": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/automattic/remote-data-blocks-demo/trunk/airtable/airtable-demo.php"
      }
    },
    {
      "step": "activatePlugin",
      "pluginPath": "airtable-demo/airtable-demo.php"
    },
    {
      "step": "mkdir",
      "path": "/wordpress/wp-content/plugins/api-monster"
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/plugins/api-monster/api-monster.php",
      "data": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/automattic/remote-data-blocks-demo/trunk/api-monster/api-monster.php"
      }
    },
    {
      "step": "activatePlugin",
      "pluginPath": "api-monster/api-monster.php"
    },
    {
      "step": "mkdir",
      "path": "/wordpress/wp-content/plugins/shopify-demo"
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/plugins/shopify-demo/ExampleShopifyDataSource.php",
      "data": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/automattic/remote-data-blocks-demo/trunk/shopify/ExampleShopifyDataSource.php"
      }
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/plugins/shopify-demo/shopify-demo.php",
      "data": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/automattic/remote-data-blocks-demo/trunk/shopify/shopify-demo.php"
      }
    },
    {
      "step": "activatePlugin",
      "pluginPath": "shopify-demo/shopify-demo.php"
    }
  ]
}
